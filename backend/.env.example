# Copiez ce fichier en ".env" et remplissez vos vraies valeurs.
# Ne commitez JAMAIS le fichier .env réel dans git.

# --- MongoDB Atlas ---
# Exemple : mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=parkimvox

# --- Sécurité JWT ---
# Générez une valeur aléatoire longue, ex: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change_moi_avec_une_valeur_aleatoire_longue
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Modèle Deep Learning ---
MODEL_PATH=models_data/best_model.keras
NORM_STATS_PATH=models_data/norm_stats.json
DECISION_THRESHOLD=0.6952

# --- CORS ---
# Origines autorisées séparées par une virgule (adresses de votre frontend)
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
